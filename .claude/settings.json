{
  "env": {
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "1000"
  },
  "permissions": {
    "allow": [
      "Read(.github/workflows/**)",
      "Edit(.github/workflows/**)"
    ],
    "deny": [
      "Edit(README.pdf)",
      "Edit(detail.pdf)",
      "Bash(git add *.pdf*)",
      "Bash(git add -A*)",
      "Bash(git add .)",
      "Bash(git commit -a*)",
      "Bash(git commit -am*)"
    ]
  },
  "enabledPlugins": {
    "notion@claude-plugins-official": true,
    "imozuru@imozuru": true
  },
  "extraKnownMarketplaces": {
    "imozuru": {
      "source": {
        "source": "github",
        "repo": "MaryCache/imozuru",
        "ref": "v2.2.0"
      }
    }
  }
}
